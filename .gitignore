node_modules
.next
tsconfig.tsbuildinfo
.vercel

# Secrets — never commit. .env.example is the only tracked env file.
.env*
!.env.example

# Eval harness: run output and the API-call cache are machine-local.
# Results that matter live in Supabase (history) and are summarised in git.
eval/runs/
eval/.cache/
coverage/

# Golden-set working state. questions.dev.jsonl and questions.holdout.jsonl ARE
# tracked — they are the source of truth every metric is computed against, and
# the holdout in particular must be fixed and reproducible across machines.
# These are not: candidates are regenerable from the cache, .reviewed is local
# review progress, and unlabelled-candidates is a scan output.
eval/golden/questions.candidate.jsonl
eval/golden/.reviewed
eval/golden/unlabelled-candidates.jsonl

# Local agent/editor config
.claude/
CLAUDE.md
.cursor/
.idea/
.vscode/
*.pem
*.key

# Fetched corpus: PDFs are reproducible from corpus/manifest.json, which IS
# tracked. Committing the papers themselves would redistribute them; committing
# the manifest lets anyone rebuild a byte-identical corpus.
corpus/*
!corpus/manifest.json
!corpus/failed.json
!corpus/scripture/
corpus/scripture/raw/
ingest-failures.json

# Phase 9 CI writes these next to the workspace root.
gate-*.md
