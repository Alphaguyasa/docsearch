SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VOYAGE_API_KEY=

# Generation provider: "anthropic" (default) or "gemini".
GENERATION_PROVIDER=anthropic
# Required only when GENERATION_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Required only when GENERATION_PROVIDER=gemini.
GEMINI_API_KEY=

# Optional. If set, the whole app requires HTTP Basic auth with this password
# (any username). Leave empty for local dev; set it for a public deployment so
# uploads/searches aren't open to anyone.
APP_PASSWORD=
